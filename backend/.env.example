# Copy this file to .env and fill in real values before running the server.

# Password required to log into the admin/analytics dashboard.
ADMIN_PASSWORD=change-this-password

# Long random string used to sign admin login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# SQLite database file path (relative to the backend folder).
DATABASE_URL=sqlite:///./campus_voice.db
